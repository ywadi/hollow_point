# Build harness output
/build/
/dist/

# Bootstrapped toolchain (zig, cmake, ninja) and their downloads.
# Recreate with ./bootstrap.sh or .\bootstrap.ps1
#
# NOTE: keep comments on their own lines. Git does not strip trailing comments
# from a pattern, so "/.harness/  # toolchain" is a literal pattern that matches
# nothing -- which is exactly how 229 MB of toolchain nearly got committed.
/.harness/

# Zig build-system cache
/.zig-cache/
/zig-out/

# Generated for clangd
compile_commands.json

# Written by CI to key the build-tree cache on the submodule SHAs (T0121).
# Local builds never produce it, but a stray untracked file in the tree is
# noise the offline-configure job would rather not have to explain.
/.ci-dep-key

# Engine build outputs are covered by /build/ and /dist/ above; nothing else
# under engine/, apps/ or samples/ is generated.
