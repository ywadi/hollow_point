// The engine's own pixel shader (T0141, D26).
//
// **This file is why D26 exists.** DiligentFX's `RenderPBR.psh` is private and
// has no hook before texture sampling, so parallax, height mapping and triplanar
// are unreachable through it at any setting. Rather than patch a vendored
// submodule, the engine owns this half and calls DiligentFX's *public* shading
// library for the lighting -- surface properties in, radiance out.
//
// The split, and it is the same one Godot and Unreal draw:
//
//   surface stage (ours)  ->  read textures, displace UVs, blend layers
//   lighting     (theirs) ->  BRDF, punctual lights, IBL, shadows
//
// **The subset is D24's, not a simplification.** DiligentFX's own material
// shader is 656 lines because it covers clearcoat, sheen, anisotropy,
// iridescence, transmission and volume. D24 keeps every one of those off, so
// reimplementing them here would be carrying code for features the engine
// deliberately does not enable. When one is turned on, it is turned on here.
//
// ---
//
// **Considered and rejected: shadowing `PBR_Textures.fxh`.** The engine's source
// factory resolves our files before DiligentFX's, so shipping a file with that
// name would make *their* `RenderPBR.psh` include *ours*, and the parallax hook
// could go there with no PSO work and no shader of our own. It was rejected
// because it is the worse coupling, not the better one: we would be
// reimplementing a **private** header against a caller we do not control, and a
// semantic change upstream would land as a subtly wrong image rather than a
// compile error. Owning our own `main` couples us to their *public* library
// instead, which is the thing they have promised to keep stable.

#include "BasicStructures.fxh"
#include "PBR_Structures.fxh"
// **Their lighting, called from our main** — this include is D26 in one line.
#include "PBR_Shading.fxh"
// **A private header, and taking it is deliberate rather than an oversight.**
// `PBRFrameAttribs` and `PBRPrimitiveAttribs` are the *layouts of the constant
// buffers `PBR_Renderer` fills*, and this engine already uses those buffers --
// `SceneRenderer.cpp` includes this very file on the C++ side to write them. So
// this is the coupling we already have, not a new one, and D26 accepted it
// explicitly: keeping their struct layouts is what keeps their lighting
// functions callable with no translation.
//
// The distinction that matters is layout versus behaviour. A layout change
// breaks the C++ that writes the buffer *and* the shader that reads it, in the
// same build, loudly. Depending on a private *function* would be the thing to
// avoid, and this shader does not.
#include "RenderPBR_Structures.fxh"
#include "HpMaterial.fxh"

// The per-pipeline interface structs, generated by `PBR_Renderer` and supplied
// through the source factory `SurfacePipeline` builds. Included **by name**, the
// same way `RenderPBR.psh` does -- which is what keeps our pixel shader and
// their vertex shader agreeing about `VSOutput` without either side restating
// it, and what makes a vertex-layout change a compile error here rather than
// garbage in the interpolators.
#include "VSOutputStruct.generated"
#include "PSOutputStruct.generated"

cbuffer cbFrameAttribs
{
    PBRFrameAttribs g_Frame;
}

cbuffer cbPrimitiveAttribs
{
    PBRPrimitiveAttribs g_Primitive;
}

cbuffer cbMaterialAttribs
{
    PBRMaterialShaderInfo g_Material;
}

// ---------------------------------------------------------------------------
// Material textures
//
// **Declared here rather than included from `PBR_Textures.fxh`, and that is
// D26.** Their header is private, and more to the point it is the *only* place
// a texture sample happens on their path -- so parallax (141.7) and triplanar
// (141.8), which both work by changing the UV before the sample, have nowhere
// to go in it. Owning the declarations is what makes the sample ours to
// displace.
//
// The names are not free choices: `PBR_Renderer::CreateSignature` registers
// `g_BaseColorMap` and `g_BaseColorMap_sampler` by exactly those spellings, so
// the pipeline only binds if we match. `SHADER_TEXTURE_ARRAY_MODE_NONE` (the
// setting `SceneRenderer` leaves at its default) is the mode that gives each
// slot its own variable; the array modes would fold them into
// `g_MaterialTextures[]` instead.
//
// **`Texture2DArray`, not `Texture2D`.** The signature declares 2D arrays so
// that a texture atlas can be dropped in later without a shader change, and the
// glTF loader creates every texture as `RESOURCE_DIM_TEX_2D_ARRAY` to match.
// A `Texture2D` here fails to bind rather than sampling wrongly, which is the
// good outcome.
// ---------------------------------------------------------------------------

#if USE_COLOR_MAP
    Texture2DArray g_BaseColorMap;
    SamplerState   g_BaseColorMap_sampler;
#endif

#if USE_PHYS_DESC_MAP
    Texture2DArray g_PhysicalDescriptorMap;
    SamplerState   g_PhysicalDescriptorMap_sampler;
#endif

#if USE_NORMAL_MAP
    Texture2DArray g_NormalMap;
    SamplerState   g_NormalMap_sampler;
#endif

/// Picks the texture coordinate set a slot was authored against.
///
/// **A `lerp` and not a branch**, because `HpSurfaceInput` always carries both
/// sets — zero-filled when the mesh has only one, which `HpMaterial.fxh`
/// promises. DiligentFX's `SelectUV` needs four preprocessor cases for the same
/// job precisely because their `VSOutput` does not make that promise.
float2 HpSelectUv(HpSurfaceInput In, float selector)
{
    return lerp(In.UV0, In.UV1, selector);
}

/// Samples one material texture, honouring its UV set, transform and wrap mode.
///
/// **`fallback` is returned untouched when the material has no texture in this
/// slot**, and that is what makes the always-on pipeline permutations safe:
/// `SceneRenderer` compiles every material with the colour, normal and
/// physical-descriptor maps enabled, so this shader is reached by materials that
/// fill none of them. Their UV selector is then -1 — `PackedProps` is zero for
/// an absent texture — and the sample never happens.
///
/// The texture is still *bound* in that case, with the renderer's white or
/// default-normal stand-in; see `SceneRenderer::ensureBindings` for why both
/// halves are needed and not either one alone.
///
/// @param tex the texture array.
/// @param texSampler its sampler.
/// @param In the surface input, for the texture coordinates.
/// @param attribs this slot's packed properties, UV transform and array slice.
/// @param fallback what to return when the slot is empty.
/// The coordinate a slot samples at, after UV-set selection and the material's
/// transform.
///
/// **Separate from the sample because the normal-mapping path needs the
/// coordinate itself**, not just the value read through it: `PerturbNormal`
/// builds its tangent frame from the screen-space derivatives of the *normal
/// map's* UV, so it has to see the transformed coordinate. This is also the
/// function 141.7's parallax displaces — it is the one place a UV is decided.
///
/// @param In the surface input, for the texture coordinates.
/// @param attribs this slot's packed properties and UV transform.
/// @param uv receives the coordinate; meaningful only when this returns true.
/// @returns whether the material actually fills this slot.
bool HpMaterialTextureUv(HpSurfaceInput In, PBRMaterialTextureAttribs attribs, out float2 uv)
{
    float selector = UnpackPBRMaterialTextureUVSelector(attribs.PackedProps);
    // **Clamped before use, and computed even when the slot is empty.** The
    // coordinate feeds `ddx`/`ddy` on the normal-map path, and derivatives are a
    // quad-wide operation — computing one under a branch some lanes of the quad
    // did not take is undefined. Costing two instructions on an empty slot is
    // the cheaper half of that trade.
    uv = HpSelectUv(In, max(selector, 0.0));

#if ENABLE_TEXCOORD_TRANSFORM
    // Scale, rotation and offset, as authored on the material. Off unless the
    // pipeline key asks for it, so a material that does not transform its UVs
    // pays nothing.
    uv = mul(uv, MatrixFromRows(attribs.UVScaleAndRotation.xy, attribs.UVScaleAndRotation.zw)) +
         float2(attribs.UBias, attribs.VBias);
#endif

    return selector >= 0.0;
}

float4 HpSampleMaterialTexture(Texture2DArray            tex,
                               SamplerState              texSampler,
                               HpSurfaceInput            In,
                               PBRMaterialTextureAttribs attribs,
                               float4                    fallback)
{
    float2 uv;
    if (!HpMaterialTextureUv(In, attribs, uv))
    {
        return fallback;
    }

    // **The sampler wraps; clamping is done by hand.** The signature installs
    // one *immutable* sampler per slot, so the wrap mode cannot follow the
    // material — it is a property of the pipeline, not of the draw. Clamping the
    // coordinate to half a texel inside the edge produces the same result for
    // the clamp case without a second sampler. Mirror is not supported, the same
    // limitation DiligentFX carries.
    uint wrapU = UnpackPBRMaterialTextureWrapUMode(attribs.PackedProps);
    uint wrapV = UnpackPBRMaterialTextureWrapVMode(attribs.PackedProps);
    const uint kClamp = 3u; // TEXTURE_ADDRESS_CLAMP
    if (wrapU == kClamp || wrapV == kClamp)
    {
        float2 size;
        float  slices;
        tex.GetDimensions(size.x, size.y, slices);
        uv.x = (wrapU == kClamp) ? clamp(uv.x, 0.5 / size.x, 1.0 - 0.5 / size.x) : uv.x;
        uv.y = (wrapV == kClamp) ? clamp(uv.y, 0.5 / size.y, 1.0 - 0.5 / size.y) : uv.y;
    }

    // **`SampleBias`, and the bias is not decoration.** `PBRFrameAttribs::Renderer`
    // went unwritten until T0134 and the garbage it left here was invisible
    // precisely because nothing had drawn a textured surface yet — every mesh
    // sampled an 8x8 default with one mip level, where any bias selects the same
    // texel. 141.11 is the test that would have caught it.
    return tex.SampleBias(texSampler, float3(uv, attribs.TextureSlice), g_Frame.Renderer.MipBias);
}

/// The standard material's surface function.
///
/// **The engine's own material is written against the same contract a game's is**
/// (D27), which is the check that keeps the contract honest: if `HpSurfaceInput`
/// is missing something, the standard material notices first.
void HpSurface(in HpSurfaceInput In, inout HpSurfaceOutput Out)
{
    // Nothing yet -- everything is pre-filled from the material, so leaving it
    // alone is exactly "the standard PBR material" (141.10).
}

/// Writes the missing-material colour (T0060.10): magenta, unlit.
///
/// Deliberately the *fallback* colour rather than an arbitrary one, so the first
/// thing this shader ever draws is a value the engine already gives a meaning
/// to, and a test asserting it is asserting something real.
PSOutput main(in VSOutput VSOut,
              in bool IsFrontFace : SV_IsFrontFace)
{
    // **Every optional field is guarded, and the guards are the same macros
    // `GetVSOutputStruct` generates the struct from.** A mesh with no texture
    // coordinates produces a `VSOutput` with no `UV0` member at all, so reading
    // it unconditionally is a *compile* error in exactly the permutation that
    // lacks it -- which is how this was found, on the untextured quad the lit
    // surface test draws.
    //
    // The contract absorbs that: `HpMaterial.fxh` documents UV1 as zero when the
    // mesh carries one set, and vertex colour as white when it carries none, so
    // a game shader may read either unconditionally and never sees the
    // permutation.
    HpSurfaceInput surfaceIn;
#if USE_TEXCOORD0
    surfaceIn.UV0 = VSOut.UV0;
#else
    surfaceIn.UV0 = float2(0.0, 0.0);
#endif
#if USE_TEXCOORD1
    surfaceIn.UV1 = VSOut.UV1;
#else
    surfaceIn.UV1 = float2(0.0, 0.0);
#endif
    surfaceIn.WorldPos = VSOut.WorldPos.xyz;
    // **The unflipped geometric normal, kept separately.** `GetPerturbNormalInfo`
    // applies the two-sided flip itself, from the `IsFrontFace` it is handed --
    // so giving it the already-flipped `surfaceIn.Normal` would flip twice and
    // hand back the *away-facing* normal on exactly the back faces the flip
    // exists to fix. The bug that produces is a double-sided surface lit
    // correctly from the front and inverted from behind, which looks like a
    // normal-map handedness problem and is not one.
    float3 geometricNormal;
#if USE_VERTEX_NORMALS
    // **Flipped for back faces, and leaving this out cost an afternoon.** A
    // double-sided surface seen from behind has a geometric normal pointing away
    // from the viewer, so every `N·L` comes out negative, clamps to zero, and the
    // surface renders **pure black** -- with the light present, the loop running
    // and the material read correctly. Diagnosed by outputting the light count
    // and `N·L` as colours: light count 1, `N·L` 0.
    //
    // `GetPerturbNormalInfo` does the same thing on DiligentFX's own path, which
    // is why the old renderer lit this quad and the first version of this shader
    // did not.
    geometricNormal = normalize(VSOut.Normal);
    surfaceIn.Normal = geometricNormal * (IsFrontFace ? 1.0 : -1.0);
#else
    // No normals on the mesh. Facing the camera is the least wrong answer: it
    // keeps the BRDF finite and the surface visible, where a zero normal makes
    // every lighting term collapse to black with no diagnostic.
    surfaceIn.Normal = float3(0.0, 0.0, -1.0);
    // Zero, deliberately: `GetPerturbNormalInfo` treats a zero-length normal as
    // "derive one from the position gradients", which is a better answer for a
    // mesh with no normals than the constant above and is the only place that
    // distinction can be made.
    geometricNormal = float3(0.0, 0.0, 0.0);
#endif
    // Zero until the vertex shader carries tangents. Documented in
    // `HpMaterial.fxh` as "zero when the mesh has no tangents", so a surface
    // function already has to tolerate it -- this is that case, not a new one.
    surfaceIn.Tangent = float4(0.0, 0.0, 0.0, 1.0);
    // **Computed, not interpolated.** `HpMaterial.fxh` argues the case: a field
    // in the contract does not imply an interpolator, and burning one on a value
    // this cheap would be paid by every draw whether a shader reads it or not.
    surfaceIn.CameraPos = g_Frame.Camera.f4Position.xyz;
    surfaceIn.ViewDir = normalize(surfaceIn.CameraPos - surfaceIn.WorldPos);
#if USE_VERTEX_COLORS
    surfaceIn.VertexColor = VSOut.Color;
#else
    // White, so a shader may multiply by it unconditionally -- which is exactly
    // what `HpMaterial.fxh` promises.
    surfaceIn.VertexColor = float4(1.0, 1.0, 1.0, 1.0);
#endif
    surfaceIn.ScreenPos = VSOut.ClipPos;

    // **Pre-filled from the material**, so a surface function that writes
    // nothing produces the standard material and one that writes a single field
    // changes exactly that field. That is what makes a three-line game shader
    // useful, and it is why `HpSurfaceOutput` is `inout`.
    PBRMaterialBasicAttribs basic = g_Material.Basic;

    HpSurfaceOutput surfaceOut;
    surfaceOut.BaseColor = basic.BaseColorFactor * surfaceIn.VertexColor;
    surfaceOut.Normal = surfaceIn.Normal;
    surfaceOut.Metallic = basic.MetallicFactor;
    surfaceOut.Roughness = basic.RoughnessFactor;
    surfaceOut.Emissive =
        float3(basic.EmissiveFactorR, basic.EmissiveFactorG, basic.EmissiveFactorB);
    surfaceOut.Occlusion = basic.OcclusionFactor;

    // -----------------------------------------------------------------------
    // The material's textures, multiplied into the factors above.
    //
    // **This is the surface stage doing its job**, and the reason D26 chose to
    // own a pixel shader rather than call one. Every line here is a place a game
    // shader will eventually be able to intervene, and the two that matter most
    // -- parallax (141.7) and triplanar (141.8) -- act on the coordinate, which
    // is why `HpMaterialTextureUv` exists as its own function.
    //
    // Each block is guarded by the same macro that declared its texture, so a
    // permutation without the map neither declares nor reads it.
    // -----------------------------------------------------------------------

#if USE_COLOR_MAP
    {
        float4 sampled = HpSampleMaterialTexture(g_BaseColorMap, g_BaseColorMap_sampler, surfaceIn,
                                                 g_Material.Textures[BaseColorTextureAttribId],
                                                 float4(1.0, 1.0, 1.0, 1.0));
        // **The sRGB decode, and it belongs here rather than in the view.**
        // `TO_LINEAR` comes from `PBR_Shading.fxh` and collapses to nothing
        // unless `TexColorConversionMode` asks for it -- `SceneRenderer` does,
        // because the sRGB texture *view* that would do this for free is behind
        // a file-static helper of DiligentFX's that nothing outside their .cpp
        // can call. Getting this wrong is not subtle: skipping it leaves every
        // albedo washed out, applying it twice leaves it muddy.
        surfaceOut.BaseColor *= float4(TO_LINEAR(sampled.rgb), sampled.a);
    }
#endif

#if USE_PHYS_DESC_MAP
    {
        // **Linear data, so no `TO_LINEAR`.** Roughness and metalness are
        // measurements, not colours; decoding them through the sRGB curve would
        // be a silent, plausible-looking error.
        float4 sampled =
            HpSampleMaterialTexture(g_PhysicalDescriptorMap, g_PhysicalDescriptorMap_sampler,
                                    surfaceIn,
                                    g_Material.Textures[PhysicalDescriptorTextureAttribId],
                                    float4(1.0, 1.0, 1.0, 1.0));
        // glTF packs **roughness in green and metallic in blue**, which is also
        // what the renderer's default 0x0000FF00 stand-in encodes. Swapping them
        // produces an image that still looks like a material, which is exactly
        // why the textured-render guard uses a set with real metalness in it.
        surfaceOut.Roughness *= sampled.g;
        surfaceOut.Metallic *= sampled.b;
    }
#endif

#if USE_NORMAL_MAP
    {
        float2 normalUv;
        bool hasNormalMap =
            HpMaterialTextureUv(surfaceIn, g_Material.Textures[NormalTextureAttribId], normalUv);
        // **Taken outside the branch on purpose.** `ddx`/`ddy` read the value
        // from neighbouring lanes in the same quad, so evaluating them where some
        // lanes did not follow the same path is undefined -- and the failure mode
        // is seams along triangle edges rather than anything that looks like a
        // bug in this code.
        float2 dUv_dx = ddx(normalUv);
        float2 dUv_dy = ddy(normalUv);

        if (hasNormalMap)
        {
            float3 tangentNormal =
                g_NormalMap.SampleBias(g_NormalMap_sampler,
                                       float3(normalUv,
                                              g_Material.Textures[NormalTextureAttribId].TextureSlice),
                                       g_Frame.Renderer.MipBias)
                    .xyz;
            // From [0,1] storage to a [-1,1] direction, then scaled. **NormalGL,
            // green pointing +Y** -- the convention T0141 fixed on and the one
            // glTF mandates; a DirectX-style map renders with its lighting
            // inverted along one axis and reads as "the light is in the wrong
            // place".
            tangentNormal = tangentNormal * 2.0 - 1.0;
            tangentNormal.xy *= basic.NormalScale;

            // **Their tangent frame, derived from screen-space gradients rather
            // than a vertex attribute.** `PerturbNormal` is public in
            // `PBR_Shading.fxh` and needs no TANGENT stream at all, which is why
            // `HpSurfaceInput::Tangent` can stay zero without costing normal
            // mapping anything -- and why a mesh authored without tangents still
            // gets a correct result here.
            PerturbNormalInfo normalInfo = GetPerturbNormalInfo(
                surfaceIn.WorldPos, geometricNormal, IsFrontFace, g_Frame.Camera.fHandness);
            surfaceOut.Normal =
                PerturbNormal(normalInfo, dUv_dx, dUv_dy, tangentNormal, /*HasUV = */ true);
        }
    }
#endif

    // **The surface stage.** Everything above is the engine's default; a game's
    // shader replaces whatever it likes here, and this is the point parallax,
    // triplanar and layer blending will act (141.7, 141.8).
    HpSurface(surfaceIn, surfaceOut);

    PSOutput Out;

#if HP_UNSHADED
    // Straight out, no BRDF, no light loop, no IBL. **A compile-time branch and
    // not a runtime one** -- an `if` would still pay for the lighting code in
    // registers and in compilation, which is the entire thing unshaded exists to
    // avoid (141.15).
    Out.Color = surfaceOut.BaseColor;
    Out.Color.rgb += surfaceOut.Emissive;
#else
    // Their lighting, from `PBR_Shading.fxh`. Surface properties in, radiance
    // out -- the split D26 chose, and the reason none of the BRDF, the punctual
    // light attenuation or the IBL is reimplemented here.
    BaseLayerShadingInfo baseLayer;
    baseLayer.Srf = GetSurfaceReflectanceMR(surfaceOut.BaseColor.rgb, surfaceOut.Metallic,
                                            surfaceOut.Roughness);
    baseLayer.Metallic = surfaceOut.Metallic;
    baseLayer.Normal = normalize(surfaceOut.Normal);
    // Clamped away from zero: a normal facing exactly edge-on makes the BRDF
    // divide by it, and the result is a ring of NaN pixels that survives into
    // the target as black or white speckle depending on the backend.
    baseLayer.NdotV = clamp(dot(baseLayer.Normal, surfaceIn.ViewDir), 1e-4, 1.0);

    SurfaceShadingInfo shading;
    shading.Pos = surfaceIn.WorldPos;
    shading.View = surfaceIn.ViewDir;
    shading.Occlusion = surfaceOut.Occlusion;
    shading.Emissive = surfaceOut.Emissive;
    shading.BaseLayer = baseLayer;
    shading.IBLScale = g_Frame.Renderer.IBLScale.rgb;

    SurfaceLightingInfo lighting = GetDefaultSurfaceLightingInfo();

#if defined(PBR_MAX_LIGHTS) && PBR_MAX_LIGHTS > 0
    {
        int lightCount = min(g_Frame.Renderer.LightCount, PBR_MAX_LIGHTS);
        for (int i = 0; i < lightCount; ++i)
        {
            ApplyPunctualLight(shading, g_Frame.Lights[i], lighting);
        }
    }
#endif

    Out.Color.rgb = ResolveLighting(shading, lighting);
    Out.Color.a = surfaceOut.BaseColor.a;
#endif

    return Out;
}
